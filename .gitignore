# Build output
bin/
obj/

# Live configuration holds SNMP community strings and management-processor passwords
# in plain text. Only the documented templates in config.example/ are tracked.
config/

# Runtime data: power history CSV and event log JSONL
data/
data.sim/

# Compose bind mounts: the same credentials as config/, plus runtime history.
docker/

# UI smoke test scaffolding
node_modules/
package-lock.json
shots/

# WSL writes these alongside files downloaded through Windows
*:Zone.Identifier

# Editors and OS cruft
.vs/
.vscode/
*.user
*.swp
.DS_Store
