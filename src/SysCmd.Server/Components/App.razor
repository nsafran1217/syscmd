@inject SysCmd.Server.Theming.ThemeResolver Theme
@inject IHttpContextAccessor Http

@{
    // Resolved here, on the server, so the very first paint is already in the chosen palette.
    // A random theme is re-rolled per document load, which is what makes it change on reload and
    // hold steady while navigating inside the app.
    var theme = Theme.Resolve(Http.HttpContext);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>syscmd</title>
    <link rel="stylesheet" href="lib/xterm/xterm.css" />
    <link rel="stylesheet" href="css/cde.css" />
    <link id="cde-theme" rel="stylesheet" href="@($"/cde/theme.css?{theme.Query}")" />
    <link rel="icon" href="img/icons/Dtterm.m.bmp" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui">
        The connection to syscmd was lost.
        <a href="" class="reload">Reload</a>
        <span class="dismiss" onclick="document.getElementById('blazor-error-ui').style.display='none'">x</span>
    </div>
    <script src="lib/xterm/xterm.js"></script>
    <script src="lib/xterm/addon-fit.js"></script>
    <script src="js/console.js"></script>
    <script src="js/ui.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
