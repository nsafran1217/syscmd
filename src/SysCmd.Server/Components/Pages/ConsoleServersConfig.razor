@page "/config/console-servers"

@inject ConfigStore Config
@inject EventLog Events

<PageTitle>Console Servers - Configuration</PageTitle>

<CdeWindow Title="Configuration - Console Servers">
    <div class="spread" style="margin-bottom:10px;">
        <h1 style="margin:0; font-size:20px;">Console Servers</h1>
        <div class="btn-row">
            <a class="cde-btn small" href="/config">Back</a>
            <button class="cde-btn small" @onclick="NewServer">New console server</button>
        </div>
    </div>

    <p class="muted" style="font-size:12px;">
        A terminal server exposes each serial port as a TCP port. Map them once here and machines
        can refer to the physical port number.
    </p>

    <div class="table-scroll">
        <table class="cde-table">
            <thead><tr><th>Id</th><th>Name</th><th>Host</th><th>Ports</th><th style="width:1%"></th></tr></thead>
            <tbody>
                @foreach (var cs in Config.Current.ConsoleServers.Values.OrderBy(c => c.Id))
                {
                    <tr>
                        <td class="mono">@cs.Id</td>
                        <td>@cs.Name</td>
                        <td class="mono muted">@cs.Host</td>
                        <td class="mono muted">
                            @string.Join(", ", cs.Ports.OrderBy(p => p.Key).Select(p => $"{p.Key}→{p.Value}"))
                        </td>
                        <td>
                            <div class="btn-row nowrap">
                                <button class="cde-btn small" @onclick="() => Edit(cs)">Edit</button>
                                <button class="cde-btn small danger" @onclick="() => _deleting = cs">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</CdeWindow>

@if (_edit is { } server)
{
    <CdeWindow Title="@($"Console Server - {(_isNew ? "new" : server.Id)}")">
        <h2 style="margin:0 0 12px; font-size:16px;">@(_isNew ? "New console server" : $"Editing {server.Id}")</h2>

        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:0 16px;">
            <label>
                <span>Id (also the file name)</span>
                <input type="text" @bind="server.Id" disabled="@(!_isNew)" />
            </label>
            <label><span>Name</span><input type="text" @bind="server.Name" /></label>
            <label><span>Host or IP</span><input type="text" @bind="server.Host" /></label>
        </div>

        <div class="cde-panel">
            <h3>Port map</h3>
            @foreach (var entry in _ports)
            {
                <div class="btn-row" style="margin-bottom:6px;">
                    <label style="margin:0;">
                        <span>Serial port</span>
                        <input type="number" min="1" style="width:90px" @bind="entry.Physical" />
                    </label>
                    <label style="margin:0;">
                        <span>TCP port</span>
                        <input type="number" min="1" style="width:110px" @bind="entry.Tcp" />
                    </label>
                    <button class="cde-btn small" @onclick="() => _ports.Remove(entry)">Remove</button>
                </div>
            }
            <div class="btn-row">
                <button class="cde-btn small" @onclick="AddPort">Add port</button>
                <button class="cde-btn small" @onclick="AddRange">Add 16 sequential ports</button>
            </div>
        </div>

        <div class="btn-row">
            <button class="cde-btn" @onclick="SaveAsync">Save console server</button>
            <button class="cde-btn" @onclick="() => _edit = null">Cancel</button>
            @if (_message is { } msg)
            {
                <span class="muted">@msg</span>
            }
        </div>
    </CdeWindow>
}

<ConfirmDialog Visible="_deleting is not null" Title="Delete console server" ConfirmLabel="Delete"
               Destructive="true" OnConfirm="DeleteAsync" OnCancel="() => { _deleting = null; }">
    <p>
        Delete <strong>@_deleting?.Name</strong>? Machines whose console or MP is reached through it
        will lose that route until they are pointed elsewhere.
    </p>
</ConfirmDialog>

@code {
    private sealed class PortEntry { public int Physical { get; set; } public int Tcp { get; set; } }

    private ConsoleServerConfig? _edit;
    private ConsoleServerConfig? _deleting;
    private List<PortEntry> _ports = [];
    private bool _isNew;
    private string? _message;

    private void NewServer()
    {
        _edit = new ConsoleServerConfig();
        _ports = [];
        _isNew = true;
        _message = null;
    }

    private void Edit(ConsoleServerConfig source)
    {
        _edit = new ConsoleServerConfig { Id = source.Id, Name = source.Name, Host = source.Host };
        _ports = [.. source.Ports.OrderBy(p => p.Key).Select(p => new PortEntry { Physical = p.Key, Tcp = p.Value })];
        _isNew = false;
        _message = null;
    }

    private void AddPort()
    {
        var next = _ports.Count == 0 ? 1 : _ports.Max(p => p.Physical) + 1;
        var tcp = _ports.Count == 0 ? 2001 : _ports.Max(p => p.Tcp) + 1;
        _ports.Add(new PortEntry { Physical = next, Tcp = tcp });
    }

    /// <summary>Most terminal servers map port N to a fixed base plus N, so offer that in one click.</summary>
    private void AddRange()
    {
        var basePort = _ports.Count == 0 ? 2000 : _ports.Max(p => p.Tcp);
        var startPhysical = _ports.Count == 0 ? 1 : _ports.Max(p => p.Physical) + 1;
        for (var i = 0; i < 16; i++)
            _ports.Add(new PortEntry { Physical = startPhysical + i, Tcp = basePort + i + 1 });
    }

    private Task SaveAsync()
    {
        if (_edit is not { } server) return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(server.Id)) { _message = "An id is required."; return Task.CompletedTask; }

        var duplicate = _ports.GroupBy(p => p.Physical).FirstOrDefault(g => g.Count() > 1);
        if (duplicate is not null)
        {
            _message = $"Serial port {duplicate.Key} is listed more than once.";
            return Task.CompletedTask;
        }

        server.Ports = _ports.ToDictionary(p => p.Physical, p => p.Tcp);

        try
        {
            Config.SaveConsoleServer(server);
            Events.Info("config", $"Console server '{server.Id}' saved from the GUI");
            _message = $"Saved at {DateTime.Now:HH:mm:ss}";
            _edit = null;
        }
        catch (Exception ex) { _message = $"Could not save: {ex.Message}"; }
        return Task.CompletedTask;
    }

    private Task DeleteAsync()
    {
        var server = _deleting;
        _deleting = null;
        if (server is null) return Task.CompletedTask;

        try
        {
            Config.DeleteConsoleServer(server.Id);
            Events.Warn("config", $"Console server '{server.Id}' deleted from the GUI");
            if (_edit?.Id == server.Id) _edit = null;
        }
        catch (Exception ex) { _message = $"Could not delete: {ex.Message}"; }
        return Task.CompletedTask;
    }
}
