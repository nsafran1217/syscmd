@* A CDE/Motif window frame drawn in CSS: title bar with working boxes, optional menu
   bar, and a sunken client area. Used both for the page's stacked windows and for the
   floating console windows. *@

<div class="cde-window @(IsShaded ? "shaded" : "") @(Maximised ? "maximised" : "") @(Floating && !Active ? "inactive" : "") @Class"
     id="@ElementId" style="@Style" @onmousedown="Activate"
     data-cw-min-width="@(Floating ? MinWidth.ToString() : null)"
     data-cw-min-height="@(Floating ? MinHeight.ToString() : null)">

    <div class="cde-titlebar" data-cw-drag="@(Floating ? "1" : null)"
         @ondblclick="OnTitleDoubleClick">

        @* Motif's window-menu box. Click opens it; double-click closes the window. *@
        <div class="menu-anchor">
            <button type="button" class="cw-box cw-menu-btn" title="Window menu"
                    aria-label="Window menu" aria-haspopup="true"
                    @onclick="ToggleWindowMenu" @onclick:stopPropagation="true"
                    @ondblclick="CloseIfPossible" @ondblclick:stopPropagation="true">
                <span class="glyph"></span>
            </button>

            @if (_windowMenuOpen)
            {
                <div class="cde-dropdown" @onclick:stopPropagation="true">
                    <button type="button" @onclick="Restore" disabled="@(!IsShaded && !Maximised)">Restore</button>
                    <button type="button" @onclick="ToggleShade" disabled="@(!CanMinimise || IsShaded)">Minimize</button>
                    <button type="button" @onclick="ToggleMaximise" disabled="@(!CanMaximise || Maximised)">Maximize</button>
                    <hr />
                    <button type="button" @onclick="CloseIfPossible" disabled="@(!CanClose)">Close</button>
                </div>
            }
        </div>

        <span class="cw-title">@Title</span>

        @if (CanMinimise)
        {
            <button type="button" class="cw-box cw-min"
                    title="@(IsShaded ? "Unroll" : "Roll up")" aria-label="@(IsShaded ? "Unroll" : "Roll up")"
                    @onclick="ToggleShade" @onclick:stopPropagation="true">
                <span class="glyph"></span>
            </button>
        }

        @if (CanMaximise)
        {
            <button type="button" class="cw-box cw-max"
                    title="@(Maximised ? "Restore" : "Maximize")" aria-label="@(Maximised ? "Restore" : "Maximize")"
                    @onclick="ToggleMaximise" @onclick:stopPropagation="true">
                <span class="glyph"></span>
            </button>
        }
    </div>

    @if (Menus is { Count: > 0 })
    {
        <div class="cde-menubar">
            @foreach (var menu in Menus)
            {
                var isOpen = _openMenu == menu.Label;
                <div class="menu-anchor">
                    <button type="button" class="@(isOpen ? "open" : "")" disabled="@menu.Disabled"
                            aria-haspopup="@(menu.Action is null ? "true" : "false")"
                            aria-expanded="@(isOpen ? "true" : "false")"
                            @onclick="() => ActivateAsync(menu)" @onclick:stopPropagation="true"
                            @onmouseenter="() => TrackMenu(menu)">
                        @Mnemonic(menu.Label, menu.MnemonicIndex)
                    </button>

                    @if (isOpen && menu.Action is null)
                    {
                        @* A pane holding a toggle indents every entry, so the labels still line
                           up under one another the way Motif lays a menu pane out. *@
                        <div class="cde-dropdown @(menu.Items.Any(i => i.Checked.HasValue) ? "has-toggles" : "")"
                             @onclick:stopPropagation="true">
                            @foreach (var item in menu.Items)
                            {
                                @if (item.IsSeparator)
                                {
                                    <hr />
                                }
                                else
                                {
                                    <button type="button" disabled="@item.Disabled"
                                            role="@(item.Checked.HasValue ? "menuitemcheckbox" : null)"
                                            aria-checked="@(item.Checked?.ToString().ToLowerInvariant())"
                                            @onclick="() => RunAsync(item)">
                                        @if (item.Checked is { } isSet)
                                        {
                                            <span class="menu-toggle @(isSet ? "on" : "")"></span>
                                        }
                                        @Mnemonic(item.Label, item.MnemonicIndex)
                                        @if (item.Accelerator is { Length: > 0 } accel)
                                        {
                                            <span class="accel">@accel</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }
            <span class="spacer"></span>
            @if (HelpMenu is { } help)
            {
                var helpOpen = _openMenu == help.Label;
                <div class="menu-anchor">
                    <button type="button" class="@(helpOpen ? "open" : "")"
                            @onclick="() => ToggleMenu(help.Label)" @onclick:stopPropagation="true"
                            @onmouseenter="() => TrackMenu(help)">
                        @Mnemonic(help.Label, help.MnemonicIndex)
                    </button>
                    @if (helpOpen)
                    {
                        <div class="cde-dropdown align-right" @onclick:stopPropagation="true">
                            @foreach (var item in help.Items)
                            {
                                @if (item.IsSeparator)
                                {
                                    <hr />
                                }
                                else
                                {
                                    <button type="button" disabled="@item.Disabled"
                                            @onclick="() => RunAsync(item)">@item.Label</button>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="window-content">
        @ChildContent
    </div>

    @if (Floating)
    {
        @* dtwm splits the resize border into eight pieces - four corner handles and four edge
           stretchers - and each one resizes from its own side. They are always in the DOM: hidden
           by CSS while rolled up or maximised, because removing them would discard the drag
           listeners bound to them. The south-east handle keeps the old cw-grip class so anything
           that reached for the single corner grip still finds one. *@
        @foreach (var edge in Edges)
        {
            <div class="cw-handle cw-h-@edge @(edge == "se" ? "cw-grip" : "")"
                 data-cw-resize="@edge" title="Resize"></div>
        }
    }

    @* Any click elsewhere dismisses an open pull-down, the way a menu bar should behave.
       It has to live inside the frame: a floating window carries its own z-index, so a
       catcher outside it would paint over the very menus it is meant to leave alone. *@
    @if (_openMenu is not null || _windowMenuOpen)
    {
        <div class="cde-overlay" style="background:transparent; z-index:30"
             @onclick="CloseMenus" @oncontextmenu="CloseMenus" @oncontextmenu:preventDefault="true"></div>
    }
</div>


@code {
    /// <summary>The eight frame pieces, in the order dtwm generates them.</summary>
    private static readonly string[] Edges = ["nw", "n", "ne", "e", "se", "s", "sw", "w"];

    /// <summary>The open pull-down was posted by the pointer crossing the bar, not by a click.</summary>
    private bool _trackedOpen;

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? ElementId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pull-downs on the left of the menu bar. Omit for a window with no menus.</summary>
    [Parameter] public IReadOnlyList<CdeMenu>? Menus { get; set; }

    /// <summary>Pushed to the right of the menu bar, where Motif puts Help.</summary>
    [Parameter] public CdeMenu? HelpMenu { get; set; }

    /// <summary>Set to make this a draggable, resizable window in the floating layer.</summary>
    [Parameter] public bool Floating { get; set; }

    /// <summary>
    /// Smallest the frame may be dragged to, in CSS pixels. It lives here rather than in the
    /// resize script so the window that knows what it holds gets to say - a console has a grid
    /// it must not fall below, an ordinary window does not.
    /// </summary>
    [Parameter] public int MinWidth { get; set; } = 280;

    [Parameter] public int MinHeight { get; set; } = 160;

    /// <summary>Whether this floating window has focus, which drives the title bar colour.</summary>
    [Parameter] public bool Active { get; set; } = true;

    /// <summary>
    /// Lets a window roll itself up when the caller does not want to own that state. Every window
    /// gets a working minimise box this way, rather than a painted-on one.
    /// </summary>
    [Parameter] public bool Collapsible { get; set; } = true;

    [Parameter] public bool Shaded { get; set; }
    [Parameter] public bool Maximised { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<bool> ShadedChanged { get; set; }
    [Parameter] public EventCallback<bool> MaximisedChanged { get; set; }
    [Parameter] public EventCallback OnActivate { get; set; }

    private string? _openMenu;
    private bool _windowMenuOpen;
    private bool _selfShaded;

    private bool CanClose => OnClose.HasDelegate;
    private bool CanMinimise => ShadedChanged.HasDelegate || Collapsible;
    private bool CanMaximise => MaximisedChanged.HasDelegate;

    /// <summary>Shading is the caller's when it supplies a callback, otherwise ours.</summary>
    private bool IsShaded => ShadedChanged.HasDelegate ? Shaded : _selfShaded;

    /// <summary>Underline one letter of a label, the way Motif marks its keyboard mnemonic.</summary>
    private static RenderFragment Mnemonic(string label, int index) => builder =>
    {
        if (index < 0 || index >= label.Length)
        {
            builder.AddContent(0, label);
            return;
        }

        builder.AddContent(1, label[..index]);
        builder.OpenElement(2, "u");
        builder.AddContent(3, label[index].ToString());
        builder.CloseElement();
        builder.AddContent(4, label[(index + 1)..]);
    };

    /// <summary>A bar entry either runs its action or opens its pull-down.</summary>
    private async Task ActivateAsync(CdeMenu menu)
    {
        if (menu.Action is not null)
        {
            CloseMenus();
            await menu.Action();
            return;
        }

        ToggleMenu(menu.Label);
    }

    /// <summary>
    /// Motif tracks the pointer along a menu bar that is already posted: sliding across another
    /// cascade button posts that one, with no second click. Nothing happens while the bar is idle,
    /// because a Motif cascade button has no pointer-over state at all - it is armed or it is not.
    /// An entry that acts on click has nothing to post, so moving onto it just unposts.
    /// </summary>
    private void TrackMenu(CdeMenu menu)
    {
        // An insensitive cascade button does not arm in Motif, so the pointer passes over it
        // without disturbing whatever is already posted.
        if (menu.Disabled) return;
        if (_openMenu is null || _openMenu == menu.Label) return;

        _openMenu = menu.Action is null ? menu.Label : null;
        _trackedOpen = _openMenu is not null;
    }

    private void ToggleMenu(string label)
    {
        _windowMenuOpen = false;

        // A click that lands on the entry the pointer just tracked onto must not unpost it: the
        // press is how you got here, and in Motif pressing a cascade button that is already
        // posted keeps it posted. Only a second, deliberate click closes it.
        if (_openMenu == label && _trackedOpen)
        {
            _trackedOpen = false;
            return;
        }

        _trackedOpen = false;
        _openMenu = _openMenu == label ? null : label;
    }

    private void ToggleWindowMenu()
    {
        _openMenu = null;
        _windowMenuOpen = !_windowMenuOpen;
    }

    private void CloseMenus()
    {
        _openMenu = null;
        _windowMenuOpen = false;
        _trackedOpen = false;
    }

    private async Task RunAsync(CdeMenuItem item)
    {
        CloseMenus();
        if (item.Action is not null) await item.Action();
    }

    private Task Activate() => OnActivate.HasDelegate ? OnActivate.InvokeAsync() : Task.CompletedTask;

    /// <summary>Double-clicking the title bar rolls the window up, as it does in CDE.</summary>
    private Task OnTitleDoubleClick() => CanMinimise ? ToggleShade() : Task.CompletedTask;

    private async Task ToggleShade()
    {
        CloseMenus();
        if (ShadedChanged.HasDelegate) await ShadedChanged.InvokeAsync(!Shaded);
        else if (Collapsible) _selfShaded = !_selfShaded;
    }

    private async Task ToggleMaximise()
    {
        CloseMenus();
        if (CanMaximise) await MaximisedChanged.InvokeAsync(!Maximised);
    }

    private async Task Restore()
    {
        CloseMenus();
        if (ShadedChanged.HasDelegate) { if (Shaded) await ShadedChanged.InvokeAsync(false); }
        else _selfShaded = false;
        if (Maximised && CanMaximise) await MaximisedChanged.InvokeAsync(false);
    }

    private async Task CloseIfPossible()
    {
        CloseMenus();
        if (CanClose) await OnClose.InvokeAsync();
    }
}
