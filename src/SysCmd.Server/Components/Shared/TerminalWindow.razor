@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ConsoleWindowManager Windows
@inject ConfigStore Config
@inject MachinePowerService Power

<CdeWindow Title="@Window.Title"
           ElementId="@Window.WindowElementId"
           Class="terminal-window"
           Style="@Geometry"
           Floating="true"
           MinWidth="MinWidth"
           MinHeight="MinHeight"
           Active="@Active"
           Menus="_menus"
           HelpMenu="_help"
           Shaded="Window.Shaded"
           ShadedChanged="OnShadedChanged"
           Maximised="Window.Maximised"
           MaximisedChanged="OnMaximisedChanged"
           OnClose="Close"
           OnActivate="Activate">

    <div class="terminal-host" id="@Window.TerminalElementId"></div>

    @if (_notice is { } notice)
    {
        <div class="terminal-notice">@notice</div>
    }
</CdeWindow>

@* Outside the frame on purpose: a floating window carries its own z-index, so a dialog rendered
   inside one would be trapped beneath the windows stacked above it. *@
<ConfirmDialog Visible="@(_confirm is not null)"
               Title="@(_confirm?.Title ?? "")"
               ConfirmLabel="@(_confirm?.ConfirmLabel ?? "OK")"
               Destructive="true"
               OnConfirm="ConfirmPowerAsync"
               OnCancel="() => _confirm = null">
    @_confirm?.Message
</ConfirmDialog>

@code {
    [Parameter, EditorRequired] public ConsoleWindow Window { get; set; } = default!;
    [Parameter] public bool Active { get; set; }

    /// <summary>
    /// Floor for the window, so a console can never be shrunk below the 80x24 a terminal is
    /// entitled to. Measured rather than guessed: the shipped 13px mono stack gives an 8.07 x
    /// 15.04 cell, so 80x24 needs a 646x361 client area, and the frame, title bar, menu bar and
    /// padding add 26 x 79 around it. A couple of pixels of slack absorbs sub-pixel rounding.
    /// A font stack without DejaVu Sans Mono may measure differently; theme-smoke asserts the
    /// grid rather than these numbers, so it is the check that matters.
    /// </summary>
    private const int MinWidth = 676;
    private const int MinHeight = 444;

    /// <summary>A power action waiting on the confirmation dialog.</summary>
    private sealed record PendingPower(PowerAction Action, string Title, string ConfirmLabel, string Message);

    private PendingPower? _confirm;

    private DotNetObjectReference<TerminalWindow>? _self;
    private IReadOnlyList<CdeMenu> _menus = [];
    private CdeMenu? _help;
    private string? _notice;
    private bool _disposed;

    /// <summary>Control sequences the menu can send, written as escapes to stay readable.</summary>
    private static class Keys
    {
        public const string Return = "\r";
        public const string CtrlB = "\u0002";
        public const string CtrlC = "\u0003";
        public const string CtrlD = "\u0004";
        public const string Escape = "\u001b";
        public const string Break = "\u001c";
    }

    /// <summary>
    /// Whether this machine has a management processor at all. Everything on the Power menu goes
    /// through one, so without it the whole menu greys out rather than offering actions that
    /// would only fail: EnqueueMachinePower refuses a reset with no MP by design.
    /// </summary>
    private bool HasMp => Config.Current.Machine(Window.MachineId)?.Mp is not null;

    private string Geometry =>
        $"left:{Window.X}px; top:{Window.Y}px; width:{Window.Width}px; height:{Window.Height}px; z-index:{Window.ZIndex};";

    protected override void OnInitialized() => BuildMenus();

    private void BuildMenus()
    {
        _menus =
        [
            new CdeMenu
            {
                Label = "Window",
                MnemonicIndex = 0,
                Items =
                [
                    CdeMenuItem.Of("Roll up", () => OnShadedChanged(!Window.Shaded)),
                    CdeMenuItem.Of("Maximize", () => OnMaximisedChanged(!Window.Maximised)),
                    CdeMenuItem.Separator,
                    CdeMenuItem.Of("Close", Close),
                ],
            },
            new CdeMenu
            {
                Label = "Edit",
                MnemonicIndex = 0,
                Items =
                [
                    CdeMenuItem.Of("Copy", () => CopyAsync(), "selection, or all"),
                    CdeMenuItem.Of("Paste", () => PasteAsync()),
                    CdeMenuItem.Separator,
                    CdeMenuItem.Of("Select all", () => Invoke("selectAll")),
                    CdeMenuItem.Of("Clear scrollback", () => Invoke("clear")),
                ],
            },
            new CdeMenu
            {
                Label = "Send",
                MnemonicIndex = 0,
                Items =
                [
                    CdeMenuItem.Of("Return", () => Send(Keys.Return)),
                    CdeMenuItem.Of("Escape", () => Send(Keys.Escape), "^["),
                    CdeMenuItem.Separator,
                    CdeMenuItem.Of("Interrupt", () => Send(Keys.CtrlC), "^C"),
                    CdeMenuItem.Of("End of file", () => Send(Keys.CtrlD), "^D"),
                    CdeMenuItem.Of("MP main menu", () => Send(Keys.CtrlB), "^B"),
                    CdeMenuItem.Of("Break", () => Send(Keys.Break), "^\\"),
                ],
            },
            new CdeMenu
            {
                Label = "Power",
                MnemonicIndex = 0,
                Items =
                [
                    // All three go through the management processor, so all three are dead
                    // without one. A machine reached over a console server may well have none.
                    CdeMenuItem.Of("Power on", () => StartPowerAsync(PowerAction.On), disabled: !HasMp),
                    CdeMenuItem.Of("Power off", () => AskPowerAsync(PowerAction.Off), disabled: !HasMp),
                    CdeMenuItem.Separator,
                    CdeMenuItem.Of("Reset", () => AskPowerAsync(PowerAction.Reset), disabled: !HasMp),
                ],
            },
            new CdeMenu
            {
                Label = "Options",
                MnemonicIndex = 0,
                Items =
                [
                    CdeMenuItem.Of("Larger text", () => FontAsync(1)),
                    CdeMenuItem.Of("Smaller text", () => FontAsync(-1)),
                    CdeMenuItem.Separator,
                    CdeMenuItem.Toggle("Black background", Window.BlackBackground, ToggleBlackAsync),
                    CdeMenuItem.Separator,
                    CdeMenuItem.Of("Refit to window", () => Invoke("refit")),
                    CdeMenuItem.Of("Reconnect", ReconnectAsync),
                ],
            },
        ];

        // Serial consoles are left alone: what is on the far end of a terminal server is
        // anyone's guess, whereas an MP has a login script we can replay.
        if (Window.Target == ConsoleTarget.Mp)
        {
            _menus = [.. _menus, new CdeMenu { Label = "Login", MnemonicIndex = 0, Action = LoginAsync }];
        }

        _help = new CdeMenu
        {
            Label = "Help",
            MnemonicIndex = 0,
            Items =
            [
                CdeMenuItem.Of("About this console", ShowHelp),
            ],
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || Window.Attached) return;
        Window.Attached = true;

        _self = DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync("syscmdUi.initWindow", Window.WindowElementId, _self);
            await JS.InvokeVoidAsync("syscmdConsole.open", Window.TerminalElementId, SocketUrl());

            // The terminal is new even when the window is not - navigating away and back
            // re-attaches it - so the override has to be re-applied rather than assumed.
            if (Window.BlackBackground)
                await JS.InvokeVoidAsync("syscmdConsole.setBlack", Window.TerminalElementId, true);
        }
        catch (JSDisconnectedException) { /* the browser went away */ }
    }

    private string SocketUrl()
    {
        var baseUri = new Uri(Nav.BaseUri);
        var scheme = baseUri.Scheme == "https" ? "wss" : "ws";
        var target = Window.Target == ConsoleTarget.Mp ? "mp" : "serial";
        return $"{scheme}://{baseUri.Authority}/ws/console/{Uri.EscapeDataString(Window.MachineId)}?target={target}";
    }

    /// <summary>Called from JavaScript when a drag or resize finishes, so the state stays in sync.</summary>
    [JSInvokable]
    public void OnGeometryChanged(int x, int y, int width, int height)
    {
        Window.X = x;
        Window.Y = y;

        // Zero means the frame was rolled up or maximised, so its box is not the size to keep.
        if (width > 0) Window.Width = Math.Max(width, MinWidth);
        if (height > 0) Window.Height = Math.Max(height, MinHeight);
    }

    private Task Activate()
    {
        Windows.Focus(Window.Id);
        return Task.CompletedTask;
    }

    private async Task OnShadedChanged(bool shaded)
    {
        Window.Shaded = shaded;
        Windows.Notify();
        if (!shaded) await Invoke("refit");
    }

    private async Task OnMaximisedChanged(bool maximised)
    {
        Window.Maximised = maximised;
        Windows.Notify();
        // The frame changes size after this render, so refit once the browser has laid it out.
        await Task.Yield();
        await Invoke("refit");
    }

    private async Task Close()
    {
        await SafeCloseTerminalAsync();
        Windows.Close(Window.Id);
    }

    private async Task ToggleBlackAsync()
    {
        Window.BlackBackground = !Window.BlackBackground;
        await Invoke("setBlack", Window.BlackBackground);

        // The menu carries the toggle's state, so it has to be rebuilt for the indicator to move.
        BuildMenus();
        StateHasChanged();
    }

    // ------------------------------------------------------------------------------- power

    /// <summary>
    /// Queues a power action and says so. Everything here goes through MachinePowerService, the
    /// same path the dashboard and the machine list use, so the shutdown-confirmation guarantee
    /// holds: switching a machine off asks its MP first and leaves the outlet on if it never
    /// confirms. The console is a view of the machine, not a way around its rules.
    /// </summary>
    private async Task StartPowerAsync(PowerAction action)
    {
        _confirm = null;

        try
        {
            var job = Power.EnqueueMachinePower(Window.MachineId, action, force: false);
            _notice = $"{job.Title} queued. Watch it on the Jobs page.";
        }
        catch (Exception ex)
        {
            _notice = ex.Message;
        }

        await Task.Yield();
        StateHasChanged();
    }

    /// <summary>
    /// Anything that takes power away asks first. Powering on does not, matching the dashboard:
    /// applying power harms nothing, taking it away can.
    /// </summary>
    private Task AskPowerAsync(PowerAction action)
    {
        var name = Window.MachineName;

        _confirm = action == PowerAction.Off
            ? new PendingPower(action, "Power off", "Power off",
                $"Shut {name} down through its management processor and switch its outlet off? " +
                "The outlet stays on if it never confirms it is down.")
            : new PendingPower(action, "Reset", "Reset",
                $"Reset {name} through its management processor? " +
                "Anything running on it stops without a clean shutdown.");

        // The click was handled inside CdeWindow, so only that component would re-render on its
        // own; the dialog belongs to this one.
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ConfirmPowerAsync()
    {
        var pending = _confirm;
        _confirm = null;
        return pending is null ? Task.CompletedTask : StartPowerAsync(pending.Action);
    }

    private Task Send(string text) => Invoke("send", text);

    /// <summary>
    /// Ask the server to replay this MP type's login steps into the open session. The exchange
    /// happens on the server so it can reuse the same expect script the power jobs use.
    /// </summary>
    private Task LoginAsync() => Invoke("command", "login");

    private async Task Invoke(string method, params object?[] args)
    {
        try
        {
            var all = new object?[args.Length + 1];
            all[0] = Window.TerminalElementId;
            args.CopyTo(all, 1);
            await JS.InvokeVoidAsync($"syscmdConsole.{method}", all);
        }
        catch (JSDisconnectedException) { /* nothing to do */ }
    }

    private async Task CopyAsync()
    {
        var copied = await Call<bool>("copy");
        await NoticeAsync(copied
            ? "Copied to the clipboard."
            : "The browser refused clipboard access; select the text and copy it by hand.");
    }

    private async Task PasteAsync()
    {
        var pasted = await Call<bool>("paste");
        if (!pasted) await NoticeAsync("The browser refused clipboard access; use the keyboard to paste.");
    }

    private async Task FontAsync(int delta)
    {
        var size = await Call<int>("setFontSize", delta);
        if (size > 0) await NoticeAsync($"Text size {size}px.");
    }

    private async Task ReconnectAsync()
    {
        await NoticeAsync("Reconnecting...");
        await Invoke("close");
        try
        {
            await JS.InvokeVoidAsync("syscmdConsole.open", Window.TerminalElementId, SocketUrl());
        }
        catch (JSDisconnectedException) { /* nothing to do */ }
    }

    private Task ShowHelp() => NoticeAsync(
        "Type straight into the terminal. The Send menu carries the control keys, and the port " +
        "allows one session at a time, so a power job will report it busy while this is open.");

    private async Task<T> Call<T>(string method, params object?[] args)
    {
        try
        {
            var all = new object?[args.Length + 1];
            all[0] = Window.TerminalElementId;
            args.CopyTo(all, 1);
            return await JS.InvokeAsync<T>($"syscmdConsole.{method}", all);
        }
        catch (JSDisconnectedException) { return default!; }
    }

    /// <summary>Show a transient line under the terminal; it clears itself.</summary>
    private async Task NoticeAsync(string message)
    {
        _notice = message;
        StateHasChanged();
        await Task.Delay(4000);
        if (_disposed || _notice != message) return;
        _notice = null;
        StateHasChanged();
    }

    private async Task SafeCloseTerminalAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("syscmdConsole.close", Window.TerminalElementId);
            await JS.InvokeVoidAsync("syscmdUi.disposeWindow", Window.WindowElementId);
        }
        catch (JSDisconnectedException) { /* already gone */ }
        catch (InvalidOperationException) { /* torn down before interop was available */ }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await SafeCloseTerminalAsync();
        _self?.Dispose();
    }
}
